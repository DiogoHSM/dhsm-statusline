#!/usr/bin/env bash
# dhsm-statusline — Claude Code status line
# Reads a JSON payload on stdin and prints 1–3 colorized lines.
#
# Customize via env vars (set in your shell profile):
#   STATUSLINE_INPUT_PRICE       USD per 1M input tokens        (default: auto-detected from model tier)
#   STATUSLINE_OUTPUT_PRICE      USD per 1M output tokens       (default: auto-detected from model tier)
#   STATUSLINE_CACHE_READ_PRICE  USD per 1M cache-read tokens   (default: auto-detected from model tier)
#   STATUSLINE_CACHE_WRITE_PRICE USD per 1M cache-write tokens  (default: auto-detected from model tier)
#   STATUSLINE_CTX_YELLOW_TOKENS Context tokens where bar turns yellow (default 120000)
#   STATUSLINE_SHOW_MEMORY       1/0 — show memory usage, macOS/Linux (default 1)
#   STATUSLINE_SHOW_GIT          1/0 — show git line           (default 1)
#
# Cost shows Claude Code's own session total (cost.total_cost_usd) when available.
# Otherwise it is estimated ("~$") from per-model pricing detected from the model id.
# Setting any STATUSLINE_*_PRICE var forces the estimate with your prices.

input=$(cat)

: "${STATUSLINE_CTX_YELLOW_TOKENS:=120000}"
: "${STATUSLINE_SHOW_MEMORY:=1}"
: "${STATUSLINE_SHOW_GIT:=1}"

RESET='\033[0m'
DIM='\033[90m'
YELLOW='\033[33m'
GREEN='\033[32m'
CYAN='\033[36m'
BLUE='\033[34m'
RED='\033[31m'

workspace_dir=$(echo "$input" | jq -r '.workspace.current_dir // empty')
model_name=$(echo "$input" | jq -r '.model.display_name // "Unknown"')
effort_level=$(echo "$input" | jq -r '.effort.level // empty')

# Auto-detect per-1M-token pricing from the model id (falls back to display name).
# Cache-write (5m) is 1.25x input; cache-read varies by model. Rates as of 2026-10.
# Unrecognized models fall back to the current Opus tier.
model_id=$(echo "$input" | jq -r '.model.id // empty')
model_lc=$(echo "${model_id:-$model_name}" | tr '[:upper:]' '[:lower:]' | tr ' .' '--')
case "$model_lc" in
  *fable-5-1*|*mythos-5-1*)                                price="10 50 0.25" ;;
  *fable*|*mythos*)                                        price="10 50 1.00" ;;
  *opus-5-5*)                                              price="4 20 0.20" ;;
  *opus-5*|*opus-4-8*|*opus-4-7*|*opus-4-6*|*opus-4-5*)    price="5 25 0.50" ;;
  *opus-4*)                                                price="15 75 1.50" ;;
  *opus*)                                                  price="4 20 0.20" ;;
  *sonnet-5*)                                              price="2 10 0.20" ;;
  *sonnet*)                                                price="3 15 0.30" ;;
  *haiku-5-5*)                                             price="0.10 0.50 0.01" ;;
  *haiku-4-5*)                                             price="1 5 0.10" ;;
  *haiku*)                                                 price="0.80 4 0.08" ;;
  *)                                                       price="4 20 0.20" ;;
esac
read -r tier_input tier_output tier_cache_read <<< "$price"
tier_cache_write=$(awk "BEGIN {print $tier_input * 1.25}")

# Prefer the session cost Claude Code computes itself, unless a price override is set.
price_override="${STATUSLINE_INPUT_PRICE:-}${STATUSLINE_OUTPUT_PRICE:-}${STATUSLINE_CACHE_READ_PRICE:-}${STATUSLINE_CACHE_WRITE_PRICE:-}"
native_cost=$(echo "$input" | jq -r '.cost.total_cost_usd // empty')

: "${STATUSLINE_INPUT_PRICE:=$tier_input}"
: "${STATUSLINE_OUTPUT_PRICE:=$tier_output}"
: "${STATUSLINE_CACHE_READ_PRICE:=$tier_cache_read}"
: "${STATUSLINE_CACHE_WRITE_PRICE:=$tier_cache_write}"

if [ -n "$native_cost" ] && [ -z "$price_override" ]; then
  cost=$(printf '$%.2f' "$native_cost")
else
  total_input=$(echo "$input" | jq -r '.context_window.total_input_tokens // 0')
  total_output=$(echo "$input" | jq -r '.context_window.total_output_tokens // 0')
  cache_read=$(echo "$input" | jq -r '.context_window.current_usage.cache_read_input_tokens // 0')
  cache_write=$(echo "$input" | jq -r '.context_window.current_usage.cache_creation_input_tokens // 0')

  cost=$(echo "$total_input $total_output $cache_read $cache_write $STATUSLINE_INPUT_PRICE $STATUSLINE_OUTPUT_PRICE $STATUSLINE_CACHE_READ_PRICE $STATUSLINE_CACHE_WRITE_PRICE" | awk '{
    total = ($1 * $5 + $2 * $6 + $3 * $7 + $4 * $8) / 1000000
    printf "~$%.2f", total
  }')
fi

mem_info=""
if [ "$STATUSLINE_SHOW_MEMORY" = "1" ] && command -v vm_stat &>/dev/null; then
  # macOS
  page_size=$(vm_stat | awk '/page size/ {print $8}')
  pages_active=$(vm_stat | awk '/Pages active/ {gsub(/\./, "", $3); print $3}')
  pages_wired=$(vm_stat | awk '/Pages wired down/ {gsub(/\./, "", $4); print $4}')
  pages_compressed=$(vm_stat | awk '/Pages occupied by compressor/ {gsub(/\./, "", $5); print $5}')
  total_mem_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)

  used_mem=$(echo "$page_size $pages_active $pages_wired $pages_compressed" | awk '{
    used = ($2 + $3 + $4) * $1
    printf "%.1f", used / 1073741824
  }')
  total_mem=$(echo "$total_mem_bytes" | awk '{printf "%.1f", $1 / 1073741824}')
elif [ "$STATUSLINE_SHOW_MEMORY" = "1" ] && [ -r /proc/meminfo ]; then
  # Linux
  read -r total_mem used_mem < <(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2}
    END {printf "%.1f %.1f", t/1048576, (t-a)/1048576}' /proc/meminfo)
fi
if [ -n "${total_mem:-}" ]; then
  mem_pct=$(echo "$used_mem $total_mem" | awk '{printf "%d", ($2 > 0 ? ($1/$2)*100 : 0)}')
  if [ "$mem_pct" -lt 50 ]; then
    mem_color="$GREEN"
  elif [ "$mem_pct" -lt 80 ]; then
    mem_color="$YELLOW"
  else
    mem_color="$RED"
  fi
  mem_info="${mem_color}${used_mem}G/${total_mem}G${RESET}"
fi

ctx_total=$(echo "$input" | jq -r '.context_window.context_window_size // 200000')
ctx_pct=$(echo "$input" | jq -r '.context_window.used_percentage // 0')
ctx_used=$(echo "$ctx_total $ctx_pct" | awk '{printf "%d", $1 * $2 / 100}')
ctx_used_k=$(echo "$ctx_used" | awk '{printf "%dk", int($1/1000)}')
ctx_total_k=$(echo "$ctx_total" | awk '{printf "%dk", int($1/1000)}')
ctx_pct_int=$(echo "$ctx_pct" | awk '{printf "%d", $1}')

bar_filled=$(awk "BEGIN {n=int(($ctx_pct_int+9)/10); if(n>10)n=10; print n}")
bar=""
for i in $(seq 1 10); do
  if [ "$i" -le "${bar_filled:-0}" ]; then
    bar="${bar}█"
  else
    bar="${bar}░"
  fi
done

ctx_used_int=$(echo "$ctx_used" | awk '{printf "%d", $1}')
if [ "$ctx_used_int" -lt "$STATUSLINE_CTX_YELLOW_TOKENS" ]; then
  bar_color="$BLUE"
elif [ "$ctx_pct_int" -lt 80 ]; then
  bar_color="$YELLOW"
else
  bar_color="$RED"
fi

five_hour_pct=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty')
five_hour_reset=$(echo "$input" | jq -r '.rate_limits.five_hour.resets_at // empty')
seven_day_pct=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')
seven_day_reset=$(echo "$input" | jq -r '.rate_limits.seven_day.resets_at // empty')

format_time_remaining() {
  local epoch="$1"
  if [ -z "$epoch" ] || [ "$epoch" = "null" ]; then echo ""; return; fi
  local now diff hours minutes
  now=$(date +%s)
  diff=$((epoch - now))
  if [ "$diff" -le 0 ]; then echo "now"; return; fi
  hours=$((diff / 3600))
  minutes=$(( (diff % 3600) / 60 ))
  if [ "$hours" -gt 0 ]; then echo "${hours}hr ${minutes}m"; else echo "${minutes}m"; fi
}

git_branch=""
git_changes=""
git_home_branch=""

if [ "$STATUSLINE_SHOW_GIT" = "1" ] && [ -n "$workspace_dir" ] && [ -d "$workspace_dir" ]; then
  git_branch=$(git -C "$workspace_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  if [ -n "$git_branch" ]; then
    insertions=$(git -C "$workspace_dir" diff --shortstat HEAD 2>/dev/null | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+' || echo "0")
    deletions=$(git -C "$workspace_dir" diff --shortstat HEAD 2>/dev/null | grep -oE '[0-9]+ deletion' | grep -oE '[0-9]+' || echo "0")
    [ -z "$insertions" ] && insertions=0
    [ -z "$deletions" ] && deletions=0
    if [ "$insertions" -gt 0 ] || [ "$deletions" -gt 0 ]; then
      git_changes="(+${insertions},-${deletions})"
    fi
    git_home_branch=$(git -C "$workspace_dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|.*/||' || echo "main")
    [ -z "$git_home_branch" ] && git_home_branch="main"
  fi
fi

line1_parts=()
if [ -n "$effort_level" ]; then
  line1_parts+=("$(printf "%bModel:%b %s %b[%s]%b" "$DIM" "$RESET" "$model_name" "$DIM" "$effort_level" "$RESET")")
else
  line1_parts+=("$(printf "%bModel:%b %s" "$DIM" "$RESET" "$model_name")")
fi
line1_parts+=("$(printf "%bCost:%b %s" "$DIM" "$RESET" "$cost")")
line1_parts+=("$(printf "%bContext:%b [%b%s%b] %s/%s (%d%%)" \
  "$DIM" "$RESET" "$bar_color" "$bar" "$RESET" \
  "$ctx_used_k" "$ctx_total_k" "$ctx_pct_int")")

line1="${line1_parts[0]}"
for i in "${!line1_parts[@]}"; do
  [ "$i" -eq 0 ] && continue
  line1="$line1 | ${line1_parts[$i]}"
done
echo -e "$line1"

line2_parts=()
if [ -n "$five_hour_pct" ] && [ "$five_hour_pct" != "null" ]; then
  five_pct_fmt=$(printf "%.1f%%" "$five_hour_pct")
  five_reset=$(format_time_remaining "$five_hour_reset")
  five_int=$(echo "$five_hour_pct" | awk '{printf "%d", $1}')
  if [ "$five_int" -lt 50 ]; then five_color="$GREEN"
  elif [ "$five_int" -lt 80 ]; then five_color="$YELLOW"
  else five_color="$RED"; fi
  part=$(printf "%bSession:%b %b%s%b" "$DIM" "$RESET" "$five_color" "$five_pct_fmt" "$RESET")
  [ -n "$five_reset" ] && part="$part$(printf " | %bReset:%b %s" "$DIM" "$RESET" "$five_reset")"
  line2_parts+=("$part")
fi

if [ -n "$seven_day_pct" ] && [ "$seven_day_pct" != "null" ]; then
  week_pct_fmt=$(printf "%.1f%%" "$seven_day_pct")
  week_reset=$(format_time_remaining "$seven_day_reset")
  week_int=$(echo "$seven_day_pct" | awk '{printf "%d", $1}')
  if [ "$week_int" -lt 50 ]; then week_color="$GREEN"
  elif [ "$week_int" -lt 80 ]; then week_color="$YELLOW"
  else week_color="$RED"; fi
  part=$(printf "%bWeekly:%b %b%s%b" "$DIM" "$RESET" "$week_color" "$week_pct_fmt" "$RESET")
  [ -n "$week_reset" ] && part="$part$(printf " | %bWeekly Reset:%b %s" "$DIM" "$RESET" "$week_reset")"
  line2_parts+=("$part")
fi

if [ "${#line2_parts[@]}" -gt 0 ]; then
  line2="${line2_parts[0]}"
  for i in "${!line2_parts[@]}"; do
    [ "$i" -eq 0 ] && continue
    line2="$line2 | ${line2_parts[$i]}"
  done
  echo -e "$line2"
fi

if [ -n "$git_branch" ] || [ -n "$mem_info" ]; then
  line3=""
  [ -n "$mem_info" ] && line3="$(printf "%bMem:%b %b" "$DIM" "$RESET" "$mem_info")"
  if [ -n "$git_branch" ]; then
    repo_name=$(basename "$workspace_dir")
    git_part=$(printf "%b⎇%b %s %b(%s)%b" "$CYAN" "$RESET" "$git_branch" "$DIM" "$repo_name" "$RESET")
    [ -n "$git_changes" ] && git_part="$git_part | $git_changes"
    [ -n "$git_home_branch" ] && git_part="$git_part | 🏠 $git_home_branch"
    [ -n "$line3" ] && line3="$line3 | $git_part" || line3="$git_part"
  fi
  echo -e "$line3"
fi
